{
  "name": "seekdeep",
  "main": "index.js",
  "pear": {
    "name": "seekdeep",
    "type": "desktop",
    "links": [
      "http://localhost:11434",
      "http://localhost:1234/api/v0/models"
    ],
    "gui": {
      "backgroundColor": "#1F2430",
      "height": "540",
      "width": "720"
    },
    "pre": "pear-electron/pre",
    "routes": "."
  },
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "version": "0.1.0",
  "description": "P2P desktop chat that proxies local LLM providers (Ollama, LM Studio) and shares a room over Hyperswarm.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noubre/seekdeep.git"
  },
  "homepage": "https://github.com/noubre/seekdeep#readme",
  "bugs": {
    "url": "https://github.com/noubre/seekdeep/issues"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "files": [
    "index.js",
    "index.html",
    "server.js",
    "tui.js",
    "bridge.js",
    "js/",
    "plugins/",
    "css/",
    "lib/",
    "screenshots/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "pear run .",
    "tui": "node tui.js",
    "bridge": "node bridge.js",
    "test": "node scripts/run-tests.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "test:smoke": "node scripts/local-pair-smoke.mjs",
    "dev:pair": "bash scripts/dev-pair.sh",
    "dev:local-dht": "node scripts/local-dht.mjs",
    "dev": "pear run -d .",
    "native:core": "cd core && swift test",
    "native:pack": "bare-pack --preset darwin --linked --base . --out app/app.bundle worklet/backend.js",
    "native:link": "bare-link --preset darwin --out app/addons .",
    "native:app": "xcodegen generate && xcodebuild -scheme SeekDeep -derivedDataPath build build",
    "native:run": "open build/Build/Products/Debug/SeekDeep.app",
    "native:dev": "node worklet/dev.js --stdio",
    "native:dev:app": "bash scripts/run-native-app.sh",
    "native:e2e": "node scripts/e2e-worklet.mjs"
  },
  "dependencies": {
    "b4a": "^1.6.4",
    "bare-fetch": "^3.4.0",
    "bare-fs": "4.5.1",
    "bare-os": "^2.2.0",
    "bare-path": "^2.1.0",
    "corestore": "7.12.2",
    "fs": "npm:bare-node-fs@^1.0.2",
    "hyperbeam": "3.1.0",
    "hypercore-crypto": "^3.3.3",
    "hyperdht": "6.33.2",
    "hyperdrive": "13.3.3",
    "hyperswarm": "^4.6.1",
    "localdrive": "2.2.1",
    "mirror-drive": "1.14.2",
    "os": "npm:bare-node-os",
    "path": "npm:bare-node-path",
    "pear-bridge": "^1.2.5",
    "pear-electron": "^1.7.28",
    "random-access-file": "^4.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "bare-link": "^3.2.2",
    "bare-pack": "^2.1.0",
    "brittle": "^3.0.0",
    "buffer": "^6.0.3",
    "jsdom": "^22.1.0",
    "node-fetch": "^3.3.2",
    "pear-interface": "^1.0.0",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "qs": "6.16.1",
    "bogon": "1.3.0"
  }
}
